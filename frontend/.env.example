NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# PayMongo public key (pk_test_... / pk_live_...) — used ONLY in the browser
# to create/attach payment methods, never in the Laravel backend
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
# Google Pay merchant ID from the Google Pay Console business verification —
# required ONLY for live ("PRODUCTION") Google Pay; leave empty in test mode
NEXT_PUBLIC_GOOGLE_PAY_MERCHANT_ID=
# Google OAuth Client ID for "Sign in with Google" (Google Identity Services) —
# created in Google Cloud Console > Credentials > OAuth Client ID > Web app.
# Copy the same value into backend/.env as GOOGLE_CLIENT_ID. Leave empty to hide
# the button.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
