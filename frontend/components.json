{
  "$schema": "https://ui.shadcn.com/schema.json",
  "style": "radix-sera",
  "rsc": true,
  "tsx": true,
  "tailwind": {
    "config": "",
    "css": "src/app/globals.css",
    "baseColor": "mist",
    "cssVariables": true,
    "prefix": ""
  },
  "iconLibrary": "lucide",
  "rtl": false,
  "menuColor": "default",
  "menuAccent": "subtle",
  "aliases": {
    "components": "@/components",
    "utils": "@/lib/utils",
    "ui": "@/components/ui",
    "lib": "@/lib",
    "hooks": "@/hooks"
  },
  "registries": {
    "@dotmatrix": "https://dotmatrix.zzzzshawn.cloud/r/{name}.json",
    "@canvas-ui": "https://canvasui.dev/r/{name}.json",
    "@fancy": "https://fancycomponents.dev/r/{name}.json",
    "@eldoraui": "https://eldoraui.site/r/{name}.json",
    "@smoothui": "https://smoothui.dev/r/{name}.json",
    "@efferd": "https://efferd.com/r/{style}/{name}.json"
  }
}
